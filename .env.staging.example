# ============================================================
# PINTU MADRASAH — contoh konfigurasi STAGING
# Salin menjadi .env.staging di server, lalu generate APP_KEY.
# Jangan commit file .env.staging yang berisi nilai asli.
# ============================================================
APP_NAME="PINTU MADRASAH"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.pintu.example.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Simpan timestamp di UTC. Tampilan memakai APP_DISPLAY_TIMEZONE.
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# =============================================
# DATABASE — MySQL 8.0
# =============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pintu_madrasah_staging
DB_USERNAME=pintu_staging
DB_PASSWORD=

# =============================================
# SESSION, CACHE, QUEUE — Redis
# =============================================
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# =============================================
# MAIL
# =============================================
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@madrasah.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================
# IDENTITAS MADRASAH
# =============================================
MADRASAH_NAME="MTs Negeri 1 Contoh"
MADRASAH_NSM="121500000000"
MADRASAH_NPSN="00000000"
MADRASAH_ADDRESS="Jl. Contoh No. 1"

# =============================================
# GOOGLE DRIVE — Service Account
# =============================================
GOOGLE_SERVICE_ACCOUNT_JSON=/var/www/pintu-madrasah/storage/app/secrets/service-account.json
GOOGLE_DRIVE_FOLDER_ID=

# =============================================
# GEMINI AI
# =============================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# =============================================
# EMIS
# =============================================
EMIS_TOKEN_TTL=7200
EMIS_GTK_TOKEN_TTL=7200

# =============================================
# API GATEWAY
# =============================================
API_GATEWAY_KEY=

# =============================================
# SEEDER ADMIN (hanya dipakai saat menjalankan db:seed)
# Kosongkan di production. Set nilai acak kuat untuk staging.
# =============================================
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
