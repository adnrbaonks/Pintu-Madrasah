APP_NAME="PINTU MADRASAH"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
# Simpan timestamp di UTC. Tampilan memakai APP_DISPLAY_TIMEZONE.
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================
# DATABASE — MySQL 8.0 (sesuai blueprint)
# Untuk development lokal, sesuaikan kredensial
# Untuk production server: DB_HOST=127.0.0.1 (aaPanel localhost)
# =============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pintu_madrasah
DB_USERNAME=root
DB_PASSWORD=

# =============================================
# SESSION & CACHE — Redis (sesuai blueprint)
# =============================================
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# =============================================
# QUEUE — Redis (untuk upload Google Drive, AI verifier)
# =============================================
QUEUE_CONNECTION=redis

# =============================================
# CACHE — Redis
# =============================================
CACHE_STORE=redis

# =============================================
# REDIS — Cache & Queue Worker
# =============================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@madrasah.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================
# MADRASAH IDENTITY (konfigurasi institusi)
# =============================================
MADRASAH_NAME="MTs Negeri 1 Contoh"
MADRASAH_NSM="121500000000"
MADRASAH_NPSN="00000000"
MADRASAH_ADDRESS="Jl. Contoh No. 1"

# =============================================
# GOOGLE DRIVE — Service Account
# (isi setelah mendapatkan kredensial dari Google Cloud Console)
# =============================================
GOOGLE_SERVICE_ACCOUNT_JSON=/www/wwwroot/pintu-madrasah/storage/app/secrets/service-account.json
GOOGLE_DRIVE_FOLDER_ID=

# =============================================
# GEMINI AI — Document Verifier
# (isi dengan API Key dari Google AI Studio)
# =============================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# =============================================
# EMIS INTEGRATION — Token Cache TTL
# =============================================
EMIS_TOKEN_TTL=7200
EMIS_GTK_TOKEN_TTL=7200

# =============================================
# API GATEWAY — Kunci akses aplikasi satelit
# (SIPSMAD, PTSP, E-Surat kirim via X-API-KEY)
# Bisa juga diatur dari menu Pengaturan (Setting api_key)
# =============================================
API_GATEWAY_KEY=

VITE_APP_NAME="${APP_NAME}"
